# Alpaca API Keys
# Paper Trading keys 通常以 PK 开头
ALPACA_API_KEY=PK_YOUR_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_SECRET_KEY_HERE

# true = Paper（模拟），false = Live（实盘）— 上线前确认
ALPACA_PAPER=true

# live 数据源：paper/live 阶段默认使用 Alpaca 数据，不依赖 yfinance
MARKET_DATA_SOURCE=alpaca
# sip = 全市场成交量，但免费数据套餐禁止查询最近 15 分钟数据（plan 16:05 拉当日线会整体失败）
# iex = 免费实时，仅 IEX 单交易所，成交量偏小；策略 Vol 过滤用相对倍数（1.2x），可接受
ALPACA_DATA_FEED=iex

# 执行安全：默认使用 DAY（OPG 需 Elite Smart Router，普通账户请勿设为 opg）
# 仅在 EXEC_MODE=three_phase 生效；moc_single 路径下所有订单强制使用 CLS/OPG TIF
ORDER_TIF=day
MIN_VALID_SYMBOLS=120
ALLOW_DUPLICATE_SIGNAL=false

# 执行模式（详见 FIX_PLAN §3 与 RESEARCH_LOG §13）：
#   three_phase (默认，向后兼容)：plan(T 16:05) → sell(T+1 15:50) → buy(T+2 09:15)
#   moc_single  (推荐)：plan(T 16:05) → execute(T+1 15:35 MOC 二腿) → reconcile(T+2 09:45)
# 切换时步骤：
#   1) 确认 cycle_plan / pending_sell / pending_buy / pending_execute 均为空（无 in-flight 周期）
#   2) 改此变量后重跑 deploy/cron_setup.sh 重装 cron（自动切换两套时序）
#   3) paper 上跑一个完整调仓周期验证再切 live
EXEC_MODE=three_phase
# MOC 提交时距收盘的余量（分钟）。Alpaca MOC 硬截止 15:50 ET；默认 15:35 提交给 15 分钟余量。
MOC_CUTOFF_MIN_BEFORE_CLOSE=10
# LOO 兜底最大追高比例：MOC 买单被拒后转 T+2 开盘 LOO 时限价 = 参考价 × (1 + 该比例)
LOO_FALLBACK_MAX_CHASE_PCT=0.03

# 个股硬止损：新增买入后挂 GTC Stop Order
ENABLE_STOP_ORDERS=true
STOP_LOSS_PCT=0.25

# 财报避雷：未来 N 个交易日内有财报发布的股票不建仓/强制平仓（0=禁用）
EARNINGS_BLACKOUT_DAYS=2

# Kill Switch 盘后限价单：盘后（16:00–20:00 ET）触发时的限价让步比例（0=直接市价单）
# 史诗级大跌时盘后买盘极度稀缺，3% 让价比 2% 更容易成交；目标是"活下去"不是卖好价
KILL_SWITCH_LIMIT_SLIPPAGE=0.03

# LULD 熔断重试：最晚重试到几点 ET 就放弃（12 = 中午）
HALT_RETRY_UNTIL_HOUR_ET=12

# LULD 熔断重试（仅买入/加仓单）：有限次数重试上限 × 每次间隔秒数，两者与
# HALT_RETRY_UNTIL_HOUR_ET 三个条件谁先到都会停止本轮重试（默认 6 次 × 300s ≈ 30 分钟）
HALT_RETRY_MAX_ATTEMPTS=6
HALT_RETRY_INTERVAL_SEC=300
# 追价上限：重试限价相对原买入计划参考价的最大允许涨幅，超过则本轮不追价提交
# （继续等待，不算失败）；与其它下单路径里 price*1.05 式的仓位规模缓冲是两个独立概念
HALT_RETRY_MAX_CHASE_PCT=0.05

# 仓位规模模拟：留空/0 = 用 Alpaca 账户真实净值（Paper 默认 $100,000）计算买入数量
# 设置后改用此金额计算买入数量，适合用实际可投资金额验证小额资金下的策略表现（整数股取整误差会被放大）
# 回撤/Kill Switch 仍按账户真实净值的百分比判断，不受此项影响
SIM_CAPITAL_USD=5000

# 单标的仓位集中度上限：等权分配超过此比例时按此比例封顶，避免当日候选标的过少
# （甚至只有1只）时单票吃满绝大部分资金——候选不足时宁可空仓，不加仓填满
MAX_POSITION_PCT=0.50

# 最小现金缓冲：仓位计算只用 (1 - 此比例) 的资金去分配，其余始终留作现金
MIN_CASH_BUFFER_PCT=0.05

# 实盘二次确认：只有 ALPACA_PAPER=false 时才需要打开
LIVE_CONFIRM=

# 邮件日报/告警：建议 Paper 测试期打开
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_receiver@example.com

# 服务失效监控：watchdog 检查最近一次运行超过该小时数则发紧急报警
WATCHDOG_MAX_AGE_HOURS=24

# 股票池/ARKK 成分监控：默认只记录变化，不自动覆盖交易股票池
AUTO_REFRESH_UNIVERSE=false

# 只读复盘 API：建议仅绑定 127.0.0.1，再通过 SSH tunnel 从本地访问
REVIEW_API_HOST=127.0.0.1
REVIEW_API_PORT=8765
REVIEW_API_TOKEN=change_me_to_a_long_random_token
REVIEW_API_URL=http://127.0.0.1:8765/review/latest
